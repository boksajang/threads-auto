{
  "name": "threads-auto",
  "productName": "Threads Auto",
  "version": "0.1.0-beta.3",
  "description": "Codex CLI 기반 멀티 계정 스레드 자동화 도구",
  "author": "복사장",
  "license": "MIT",
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25 || >=26"
  },
  "scripts": {
    "setup": "npm ci --ignore-scripts && node node_modules/electron/install.js && node node_modules/esbuild/install.js && node native-host/build.mjs",
    "native-host:build": "node native-host/build.mjs",
    "prestart": "npm run native-host:build",
    "start": "electron-forge start",
    "prepackage": "npm run native-host:build",
    "package": "electron-forge package",
    "premake": "npm run native-host:build",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint",
    "check:internal": "npm run check && npm test"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-squirrel-startup": "1.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rss-parser": "3.13.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "44.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.3",
    "vitest": "4.1.11"
  }
}
